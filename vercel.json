{
  "rewrites": [
    { "source": "/c/:slug/edit", "destination": "/edit.html" },
    { "source": "/go/:slug/edit", "destination": "/edit.html" },
    { "source": "/c/:slug*", "destination": "/index.html" },
    { "source": "/go/:slug*", "destination": "/index.html" },
    { "source": "/((?!.*\\.).*)", "destination": "/index.html" }
  ]
}
